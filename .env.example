# ---------------------------------------------------------------------------
# Senami - environment configuration template
#
# Copy to `.env.local` for local development:
#   cp .env.example .env.local
#
# NEVER commit a populated `.env` file. Values are never printed to logs or
# returned by the health endpoint (spec sections 41, 50, 55).
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
# Public, non-sensitive. Safe to expose to the browser.
NEXT_PUBLIC_APP_NAME=Senami

# --- Database (Phase 5) ----------------------------------------------------
# PostgreSQL connection string. In the initial mock-data build this may be
# unset; the app degrades to the deterministic in-memory demo dataset.
DATABASE_URL=

# --- Cache / queue (optional, Phase 5+) -----------------------------------
# Redis is optional. Leave unset to run without it.
REDIS_URL=

# --- Authentication (Phase 4) ----------------------------------------------
# HMAC key used to sign session cookies. MUST be set in production.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Leave unset in development to use a clearly-marked ephemeral dev key.
SESSION_SECRET=
# Session lifetime in seconds (default 8h).
SESSION_TTL_SECONDS=28800

# --- AI (Phase 9) ----------------------------------------------------------
# `mock` is fully deterministic and requires no API key. Never set the key in
# a repository; production keys are server-side only (spec sections 40, 55).
AI_PROVIDER=mock
AI_API_KEY=

# --- Observability ---------------------------------------------------------
# Never set to a value that would leak environment contents.
LOG_LEVEL=info
